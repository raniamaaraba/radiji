import customtkinter
import tkinter


def autoComplete(a,b):
    print(a)
    print(b)
    return ["a", "l", "4"]

def searchBarValueChanged(value):
    print(value)
    
class SearchBar(tkinter.Frame):
    def __init__(self,parent,allItems, widthInText = 30, autoCompleteFunction = None, valuesToDisplay=4):
        tkinter.Frame.__init__(self,parent)
        self.width = widthInText
        self.allItems = allItems
        self.autoCompleteFunction = autoCompleteFunction
        self.valuesToDisplay = valuesToDisplay
        if len(self.allItems) > self.valuesToDisplay:
            self.displayValues = self.allItems[:self.valuesToDisplay]
        else:
            self.displayValues = self.allItems
        self.search

class buttonFrame(customtkinter.CTkFrame):
    def __init__(self, master):
        super().__init__(master)

        #add button for the dictionary tab
        dictButton = customtkinter.CTkButton(self, text="Dictonary", command=self.button_callback)
        dictButton.grid(row=0,column=0,padx=20,pady=20,columnspan=1)
        dictButton = customtkinter.CTkButton(self, text="Dictonary",command=self.button_callback)
        dictButton.grid(row=0,column=0,padx=10,pady=20, columnspan=1)
        
        #add button for extra resources
        resourceButton = customtkinter.CTkButton(self, text="Resources",command=self.button_callback)
        resourceButton.grid(row=3,column=0,padx=20,pady=20,columnspan=1)
        
        #add check box for romanji
        checkbox_romaji = customtkinter.CTkCheckBox(self, text="Enable Romaji")
        checkbox_romaji.grid(row=5,column=0,padx=20,pady=20)
        
        
    def get(self):
        checked_checkbox = []
        if self.checkbox_romaji.get() == 1:
            checked_checkbox.append(self,checkbox_romaji.cget("text"))
            
    def button_callback(self):
        print("button pressed")
        
class dictonaryFrame(customtkinter.CTkFrame):
    def __init__(self, master):
        super().__init__(master)

        #make the second panel
        self.dictonary_panel = customtkinter.CTkFrame(self, corner_radius=8)
        #self.dictonary_panel.grid(side=tkinter.LEFT, fill=tkinter.Y, expand=False,padx=20,pady=10)
        
        #pull page for dictonary if clicked
    
        

class App(customtkinter.CTk):
    def __init__(self):
        super().__init__()

        #intialise name and size
        self.title("Radiji")
        self.geometry("500x600")
        self.grid_columnconfigure((0, 1), weight=1)
        
        self.checkbox_frame = buttonFrame(self)
        self.checkbox_frame.grid(row=0, column=0, padx=10, pady=(10, 0), sticky="nsw")
        
        self.dictonary_frame = dictonaryFrame(self)
        self.dictonary_frame.grid(row=0,column=1,padx=10,pady=10)
        
    def button_callback(self):
        print("checked checkboxes:", self.checkbox_frame.get())
        
        
        
        
    


app = App()
app.mainloop()


#buttons: home, Resources, dictonary
